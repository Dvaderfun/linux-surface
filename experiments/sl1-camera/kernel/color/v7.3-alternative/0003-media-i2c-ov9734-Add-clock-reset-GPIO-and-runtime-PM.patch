From 1ed0ae8f161a610e093fd3e99e2bda4bdc6827d0 Mon Sep 17 00:00:00 2001
From: Sam <sammydirksz@gmail.com>
Date: Wed, 18 Nov 2026 16:52:24 +0100
Subject: [PATCH 3/3] media: i2c: ov9734: Add clock, reset GPIO and runtime PM
 power control

The driver relies on ACPI power resources to power the sensor. On the
Microsoft Surface Laptop 2 the sensor's power resource is a stub and
power is described by a discrete INT3472 device instead: a GPIO-gated
19.2 MHz clock and a reset GPIO. The int3472 driver registers both for
the sensor, but ov9734 never enables the clock or releases reset, so the
chip does not answer on I2C.

Enable the clock and release the optional reset GPIO in runtime resume,
and reverse it in runtime suspend. Both are no-ops on designs that have
neither, where the clock is the fixed-rate dummy and the GPIO is absent.

Runtime PM callbacks only: ipu3-cio2 stops and restarts the sensor across
system suspend through .s_stream(), so system sleep callbacks in the sensor
driver would race with the bridge.

Tested on a Surface Laptop 2 with 7.3.4-surface: chip ID reads, 1296x734
SGRBG10 streams at 30 fps, and a running stream survives s2idle.

The out-of-tree fix at https://github.com/tomgood18/surface-laptop-2-camera
takes the same approach for this machine.

Assisted-by: Claude Fable 5.2
Signed-off-by: Sam <sammydirksz@gmail.com>
Patchset: cameras
---
 drivers/media/i2c/ov9734.c | 72 +++++++++++++++++++++++++++++++++++---
 1 file changed, 67 insertions(+), 5 deletions(-)

diff --git a/drivers/media/i2c/ov9734.c b/drivers/media/i2c/ov9734.c
index 866de7f75c0c51be64361a3c64c9a88c07d9b808..2f8eace5321c0945b4fc7c5024f746e4853844b4 100644
--- a/drivers/media/i2c/ov9734.c
+++ b/drivers/media/i2c/ov9734.c
@@ -4,6 +4,7 @@
 #include <linux/acpi.h>
 #include <linux/clk.h>
 #include <linux/delay.h>
+#include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
 #include <linux/module.h>
 #include <linux/pm_runtime.h>
@@ -325,6 +326,7 @@ static const struct ov9734_mode supported_modes[] = {
 struct ov9734 {
 	struct device *dev;
 	struct clk *clk;
+	struct gpio_desc *reset;
 
 	struct v4l2_subdev sd;
 	struct media_pad pad;
@@ -877,6 +879,36 @@ check_hwcfg_error:
 	return ret;
 }
 
+static int ov9734_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct ov9734 *ov9734 = to_ov9734(sd);
+	int ret;
+
+	ret = clk_prepare_enable(ov9734->clk);
+	if (ret)
+		return ret;
+
+	/* Let the clock settle before releasing reset */
+	usleep_range(1000, 1500);
+	gpiod_set_value_cansleep(ov9734->reset, 0);
+	/* Wait for the sensor to come out of reset before using I2C */
+	usleep_range(10000, 15000);
+
+	return 0;
+}
+
+static int ov9734_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct ov9734 *ov9734 = to_ov9734(sd);
+
+	gpiod_set_value_cansleep(ov9734->reset, 1);
+	clk_disable_unprepare(ov9734->clk);
+
+	return 0;
+}
+
 static void ov9734_remove(struct i2c_client *client)
 {
 	struct v4l2_subdev *sd = i2c_get_clientdata(client);
@@ -886,7 +918,10 @@ static void ov9734_remove(struct i2c_client *client)
 	media_entity_cleanup(&sd->entity);
 	v4l2_ctrl_handler_free(sd->ctrl_handler);
 	pm_runtime_disable(ov9734->dev);
-	pm_runtime_set_suspended(ov9734->dev);
+	if (!pm_runtime_status_suspended(ov9734->dev)) {
+		ov9734_power_off(ov9734->dev);
+		pm_runtime_set_suspended(ov9734->dev);
+	}
 	mutex_destroy(&ov9734->mutex);
 }
 
@@ -918,11 +953,23 @@ static int ov9734_probe(struct i2c_client *client)
 				     "external clock %lu is not supported",
 				     freq);
 
+	/* Optional: on ACPI designs without it the power resources do the work */
+	ov9734->reset = devm_gpiod_get_optional(ov9734->dev, "reset",
+						GPIOD_OUT_HIGH);
+	if (IS_ERR(ov9734->reset))
+		return dev_err_probe(ov9734->dev, PTR_ERR(ov9734->reset),
+				     "failed to get reset GPIO\n");
+
 	v4l2_i2c_subdev_init(&ov9734->sd, client, &ov9734_subdev_ops);
+
+	ret = ov9734_power_on(ov9734->dev);
+	if (ret)
+		return dev_err_probe(ov9734->dev, ret, "failed to power on\n");
+
 	ret = ov9734_identify_module(ov9734);
 	if (ret) {
 		dev_err(ov9734->dev, "failed to find sensor: %d", ret);
-		return ret;
+		goto probe_error_power_off;
 	}
 
 	mutex_init(&ov9734->mutex);
@@ -945,12 +992,11 @@ static int ov9734_probe(struct i2c_client *client)
 	}
 
 	/*
-	 * Device is already turned on by i2c-core with ACPI domain PM.
-	 * Enable runtime PM and turn off the device.
+	 * The device is powered on at this point. Enable runtime PM before
+	 * registering the subdev; it is turned off once registration is done.
 	 */
 	pm_runtime_set_active(ov9734->dev);
 	pm_runtime_enable(ov9734->dev);
-	pm_runtime_idle(ov9734->dev);
 
 	ret = v4l2_async_register_subdev_sensor(&ov9734->sd);
 	if (ret < 0) {
@@ -959,6 +1005,8 @@ static int ov9734_probe(struct i2c_client *client)
 		goto probe_error_media_entity_cleanup_pm;
 	}
 
+	pm_runtime_idle(ov9734->dev);
+
 	return 0;
 
 probe_error_media_entity_cleanup_pm:
@@ -970,9 +1018,22 @@ probe_error_v4l2_ctrl_handler_free:
 	v4l2_ctrl_handler_free(ov9734->sd.ctrl_handler);
 	mutex_destroy(&ov9734->mutex);
 
+probe_error_power_off:
+	ov9734_power_off(ov9734->dev);
+
 	return ret;
 }
 
+/*
+ * Runtime PM only. The bridge driver stops and restarts the stream across
+ * system suspend through .s_stream(); system sleep callbacks here would cut
+ * the power before the bridge has stopped the sensor and restore it only
+ * after the bridge has tried to restart it.
+ */
+static const struct dev_pm_ops ov9734_pm_ops = {
+	RUNTIME_PM_OPS(ov9734_power_off, ov9734_power_on, NULL)
+};
+
 static const struct acpi_device_id ov9734_acpi_ids[] = {
 	{ "OVTI9734", },
 	{}
@@ -983,6 +1044,7 @@ MODULE_DEVICE_TABLE(acpi, ov9734_acpi_ids);
 static struct i2c_driver ov9734_i2c_driver = {
 	.driver = {
 		.name = "ov9734",
+		.pm = pm_ptr(&ov9734_pm_ops),
 		.acpi_match_table = ov9734_acpi_ids,
 	},
 	.probe = ov9734_probe,
