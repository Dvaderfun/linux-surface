+/* Limit this external-module backport to the verified SL1 firmware module. */
+static bool ov7251_has_sl1_strobe(struct ov7251 *ov7251)
+{
+	struct acpi_device *adev = ACPI_COMPANION(ov7251->dev);
+	const char *sub;
+	bool supported;
+
+	if (!adev || strcmp(acpi_device_hid(adev), "INT347E") ||
+	    !dmi_match(DMI_SYS_VENDOR, "Microsoft Corporation") ||
+	    !dmi_match(DMI_PRODUCT_NAME, "Surface Laptop") ||
+	    !dmi_match(DMI_PRODUCT_SKU, "Surface_Laptop"))
+		return false;
+
+	sub = acpi_get_subsystem_id(adev->handle);
+	if (IS_ERR_OR_NULL(sub))
+		return false;
+	supported = !strcmp(sub, "MSHW0074");
+	kfree(sub);
+	return supported;
+}
+
+static int ov7251_disable_strobe_pad(struct ov7251 *ov7251)
+{
+	int ret = ov7251_write_reg(ov7251, OV7251_SC_REG5, 0);
+
+	if (!ret)
+		ov7251->strobe_live = false;
+	return ret;
+}
+
+static int ov7251_set_strobe(struct ov7251 *ov7251, bool enabled)
+{
+	u8 val[4];
+	int span = OV7251_STROBE_FRAME_SPAN_DEF;
+	int ret, vts;
+
+	/* Program the pattern and bounded span with the output gated off. */
+	ret = ov7251_disable_strobe_pad(ov7251);
+	if (ret)
+		return ret;
+	if (enabled) {
+		vts = ov7251->current_mode->height + ov7251->vblank->val;
+		span = min(clamp(ov7251->exposure->val, OV7251_STROBE_SPAN_MIN,
+				 OV7251_STROBE_SPAN_MAX),
+			   vts * OV7251_STROBE_MAX_DUTY_PERCENT / 100);
+	}
+	ret = ov7251_write_reg(ov7251, OV7251_STROBE_FRAME_PATTERN,
+			       enabled ? OV7251_STROBE_FRAME_PATTERN_ALT :
+					 OV7251_STROBE_FRAME_PATTERN_DEF);
+	if (ret)
+		return ret;
+	put_unaligned_be32(span, val);
+	ret = ov7251_write_seq_regs(ov7251, OV7251_STROBE_FRAME_SPAN, val, sizeof(val));
+	if (ret || !enabled)
+		return ret;
+	ret = ov7251_write_reg(ov7251, OV7251_SC_REG5, OV7251_SC_REG5_STROBE_OE);
+	if (ret)
+		ov7251_disable_strobe_pad(ov7251);
+	else
+		ov7251->strobe_live = true;
+	return ret;
+}
