+/*
+ * The OV9734 can feed its 1296x734 mode into the ImgU at 1296x732
+ * with no Bayer downscale, leaving enough filter margin for 1280x720.
+ * This combination has been validated only with a single processed stream.
+ */
+static bool ov9734SupportsHD(const CameraSensor *sensor, const Size &input)
+{
+	return input == Size(1296, 734) && sensor->model() == "ov9734";
+}
